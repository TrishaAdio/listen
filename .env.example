# ---- Server ----
PORT=3000

# ---- Transcription provider ----
# Choose one: "elevenlabs" (Scribe), "openai" (gpt-4o-transcribe), or "groq" (whisper-large-v3-turbo)
PROVIDER=elevenlabs

# ElevenLabs (used when PROVIDER=elevenlabs). Free-tier speech-to-text.
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx
# Backup key — used automatically if the primary is invalid or out of quota.
# Leave blank and the server will ask for it at startup (and save it here).
ELEVENLABS_API_KEY_BACKUP=
# scribe_v1 is widely available on free tier; scribe_v2 is newer/higher quality.
ELEVENLABS_MODEL=scribe_v1

# OpenAI (used when PROVIDER=openai). Best accuracy voice model.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-transcribe

# Groq (used when PROVIDER=groq). Very fast, English-optimized.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=whisper-large-v3-turbo

# ---- Telegram ----
# Create a bot with @BotFather to get the token.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxx
# Admin chat ids that receive the transcriptions.
# You can list both here comma-separated, e.g. TELEGRAM_ADMIN_ID=111111111,222222222
TELEGRAM_ADMIN_ID=111111111
# ...or set the second admin separately:
TELEGRAM_ADMIN_ID_2=222222222


# ---- Forward gate ----
# Only transcripts mentioning one of these words are sent to Telegram.
KEYWORDS=received,credited,debited,payment,paid,transfer,transferred,sent,rupees,balance
# Any transcript containing a number is always sent in full. Set to false to disable.
SEND_ON_NUMBER=true
