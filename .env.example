# ---- Server ----
PORT=3000

# ---- Transcription provider ----
# Choose one: "elevenlabs" (Scribe), "openai" (gpt-4o-transcribe), or "groq" (whisper-large-v3-turbo)
PROVIDER=elevenlabs

# ElevenLabs (used when PROVIDER=elevenlabs). Free-tier speech-to-text.
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx
# scribe_v1 is widely available on free tier; scribe_v2 is newer/higher quality.
ELEVENLABS_MODEL=scribe_v1

# OpenAI (used when PROVIDER=openai). Best accuracy voice model.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-transcribe

# Groq (used when PROVIDER=groq). Very fast, English-optimized.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=whisper-large-v3-turbo

# ---- Telegram ----
# Create a bot with @BotFather to get the token.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxx
# Numeric chat id of the admin who receives the transcriptions.
TELEGRAM_ADMIN_ID=123456789
